<StackPane
	xmlns:fx="http://javafx.com/fxml/1"
  fx:id="main"
	fx:controller="ict373.assignment2.controllers.HomeController"
>
  <BorderPane	fx:id="content">
    <left>
      <ListView fx:id="nav_items">
        <items>
          <FXCollections fx:factory="observableArrayList">
            <String fx:value="Customers" />
